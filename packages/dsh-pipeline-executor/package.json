{
  "name": "dsh-pipeline-executor",
  "version": "0.1.7",
  "description": "Declarative multi-agent pipeline executor for DeepSeek Harness (dsh): runs a manifest of confined role dispatches with mechanical gates and a machine-written evidence ledger. dsh \u58f0\u660e\u5f0f\u591a\u89d2\u8272\u6d41\u6c34\u7ebf\u6267\u884c\u5668\uff1a\u6309 manifest \u6d3e\u53d1\u53d7\u9650\u5b50\u4ee3\u7406\u3001\u673a\u68b0\u95e8\u7981\u3001\u673a\u5668\u5199\u8bc1\u636e\u8d26\u672c\u3002",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "pipeline",
    "subagent",
    "orchestration",
    "evidence-ledger"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./manifest": "./lib/manifest.js",
    "./dispatch": "./lib/dispatch.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.5",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "dependencies": {}
}
