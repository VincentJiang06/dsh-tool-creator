{
  "$comment": "dsh-forge pipeline manifest — the declarative control flow the dsh-pipeline-executor runs. This file IS the pipeline: stages, role confinement, gates, retries. The conductor model never sees or transmits it; the executor reads it from disk. File-reference paths (roles/, schemas/, prompts/) are preset-dir-relative. Gate argv elements are template-rendered by the executor (0.1.3) before execFile: gates run with cwd = workspace, so validator paths are spelled {{PRESET_DIR}}-absolute and workspace paths {{WORKSPACE}}-absolute. L0 draft — L1 implements the executor against exactly this shape; fields may only be added, never reinterpreted.",
  "manifestVersion": 1,
  "pipeline": "tool-creator",
  "defaults": {
    "provider": "deepseek-official",
    "model": "deepseek-v4-pro",
    "retries": 2,
    "workspaceLayout": {
      "request": "request.md",
      "artifacts": "artifacts/",
      "build": "build/",
      "gateLogs": "gate-logs/",
      "ledger": "evidence-ledger.jsonl"
    }
  },
  "stages": [
    {
      "id": "composer",
      "role": {
        "persona": "roles/composer.md",
        "tools": ["read"],
        "maxTokens": 24576
      },
      "dispatch": {
        "promptTemplate": "manifest/prompts/composer.md",
        "outputSchema": "schemas/skill-spec.json"
      },
      "artifact": "artifacts/skill-spec.json",
      "gate": { "cmd": ["python3", "{{PRESET_DIR}}/validators/validate_spec.py", "{{WORKSPACE}}/artifacts/skill-spec.json"] }
    },
    {
      "id": "guidance",
      "role": {
        "persona": "roles/guidance.md",
        "tools": ["read"],
        "maxTokens": 40960
      },
      "dispatch": {
        "promptTemplate": "manifest/prompts/guidance.md",
        "outputSchema": "schemas/structure-contract.json"
      },
      "artifact": "artifacts/structure-contract.json",
      "gate": { "cmd": ["python3", "{{PRESET_DIR}}/validators/validate_structure.py", "{{WORKSPACE}}/artifacts/structure-contract.json", "--target-dir", "{{WORKSPACE}}/build"] }
    },
    {
      "id": "engineer",
      "role": {
        "persona": "roles/engineer.md",
        "tools": ["read", "write", "edit", "bash"],
        "maxTokens": 65536
      },
      "dispatch": {
        "promptTemplate": "manifest/prompts/engineer.md",
        "outputSchema": "schemas/evidence-dossier.json"
      },
      "artifact": "artifacts/evidence-dossier.json",
      "gate": {
        "cmd": ["python3", "{{PRESET_DIR}}/validators/validate_report.py", "{{WORKSPACE}}/artifacts/evidence-dossier.json", "--target-dir", "{{WORKSPACE}}/build"],
        "then": ["python3", "{{PRESET_DIR}}/validators/validate_structure.py", "{{WORKSPACE}}/artifacts/structure-contract.json", "--target-dir", "{{WORKSPACE}}/build", "--check-files"]
      }
    },
    {
      "id": "zipper",
      "role": {
        "persona": "roles/zipper.md",
        "tools": ["read", "write", "edit"],
        "maxTokens": 32768
      },
      "dispatch": {
        "promptTemplate": "manifest/prompts/zipper.md",
        "outputSchema": "schemas/compression-report.json"
      },
      "artifact": "artifacts/compression-report.json",
      "gate": { "cmd": ["python3", "{{PRESET_DIR}}/validators/validate_compression.py", "{{WORKSPACE}}/artifacts/compression-report.json"] }
    },
    {
      "id": "battery",
      "fanout": {
        "$comment": "Five fresh lens attackers + one synthesis, per the battery role pack. Each lens is an independent dispatch; synthesis reads the union. Seeds are planted by the stage prompt from seeds/ before dispatch.",
        "lenses": ["coherence", "gaming", "evidence", "reality", "foundation"],
        "lensPersona": "roles/battery.md",
        "lensTools": ["read", "bash", "web_search"],
        "lensMaxTokens": 32768,
        "synthesis": {
          "persona": "roles/battery.md",
          "tools": ["read"],
          "maxTokens": 32768
        }
      },
      "dispatch": {
        "promptTemplate": "manifest/prompts/battery.md",
        "outputSchema": "schemas/decision-record.json"
      },
      "artifact": "artifacts/decision-record.json",
      "gate": {
        "$comment": "L4 chain: the fold gate first, then the MECHANICAL evidence assembler — `then` runs only on validate_decision exit 0 (an acceptance manifest is never assembled from an invalid decision record), and its exit IS the gate verdict (a refused assembly is a red battery gate: evidence ships or the stage fails). --provider mirrors defaults.provider (the ledger pins roleModel but not provider).",
        "cmd": ["python3", "{{PRESET_DIR}}/validators/validate_decision.py", "{{WORKSPACE}}/artifacts/decision-record.json"],
        "then": ["python3", "{{PRESET_DIR}}/validators/assemble_manifest.py", "--workspace", "{{WORKSPACE}}", "--build-subdir", "build", "--out", "{{WORKSPACE}}/artifacts/acceptance-manifest.json", "--provider", "deepseek-official"]
      }
    }
  ]
}
